# =====================================================================
# Chol Ghuri settings - copy this file to config/.env and fill it in.
# config/.env is private: never upload it publicly or put it in a report.
# =====================================================================

# Full address of the site, WITHOUT a trailing slash.
# Every link in emails (verification, password reset) is built from this.
#   Local testing on this computer:  http://localhost/chol-ghuri
#   After deployment, for example:   https://cholghuri.example.com
APP_URL=http://localhost/chol-ghuri

# Show detailed PHP/database/SMTP errors on screen (true while developing).
APP_DEBUG=false

# ---------------------------------------------------------------------
# Outgoing email (SMTP). Used for account verification and password reset.
#
# Example for Gmail:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password: Google Account > Security > App passwords.
#   3. Use these values (the App Password is 16 letters, no spaces):
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_ENCRYPTION=tls
#        SMTP_USERNAME=your.address@gmail.com
#        SMTP_PASSWORD=abcdefghijklmnop
#        MAIL_FROM=your.address@gmail.com
#
# SMTP_ENCRYPTION: tls (port 587), ssl (port 465) or none (local test servers)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="Chol Ghuri"
